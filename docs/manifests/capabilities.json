{
  "version": "2.0",
  "contractVersion": "1.0",
  "source": "src/index.mjs#getCapabilities",
  "perChartProfiles": "src/index.mjs#getChartCapability",
  "agentPlanning": "src/index.mjs#planChart",
  "agentExplanation": "Chart#explain",
  "agentQuickstart": "docs/agent/quickstart.md",
  "usageScenarios": "docs/agent/usage-scenarios.md",
  "agentWorkflowExample": "examples/agent-workflow.mjs",
  "officialSkill": "skills/ichartjs/SKILL.md",
  "scenarios": {
    "charting": ["line", "area", "bar", "column", "pie", "scatter", "funnel", "gauge", "heatmap", "radar"],
    "project": ["gantt", "timeline", "milestone", "burndown"],
    "diagram": ["flow", "swimlane", "architecture", "mindmap"]
  },
  "projectIntelligence": ["variance", "capacity", "release", "risk", "aging"],
  "chartModes": ["stacked", "percent-stacked", "donut", "mixed-line-column", "bin", "architecture-layers", "architecture-boundaries", "mindmap-tree", "mindmap-radial", "mindmap-curved-edges"],
  "renderers": ["canvas", "svg"],
  "interactionDefaults": { "zoom": false, "pan": false, "brush": false, "drag": false, "edgeDrag": false, "portConnect": false, "editing": false },
  "diagramEditing": {
    "renderers": ["canvas", "svg"],
    "edgeSelection": true,
    "waypointDrag": true,
    "segmentDrag": true,
    "persistentWaypoints": true,
    "enabledByDefault": false,
    "activation": ["editing.enabled", "interaction.edgeDrag"]
  },
  "diagramCurves": {
    "renderers": ["canvas", "svg"],
    "type": "cubic-bezier",
    "mindmapDefault": true,
    "curveTension": { "minimum": 0.2, "maximum": 0.8, "default": 0.4 },
    "obstacleFallback": "orthogonal",
    "controlPointEditing": false
  },
  "excluded": ["map", "3d"],
  "exports": ["png", "svg", "json"],
  "headless": {
    "preview": true,
    "json": true,
    "svg": true,
    "png": "Node headless PNG requires the optional `canvas` npm package and chart.exportAsync({type:\"png\"}). Otherwise use chart.export({type:\"svg\"})."
  },
  "export": {
    "types": ["png", "jpeg", "svg", "json"],
    "mime": { "png": "image/png", "jpeg": "image/jpeg", "svg": "image/svg+xml", "json": "application/json" },
    "browser": { "png": true, "jpeg": true, "svg": true, "json": true },
    "headless": {
      "png": "optional: install the `canvas` npm package for createCanvas and use exportAsync",
      "jpeg": "same as png",
      "svg": true,
      "json": true
    },
    "methods": {
      "exportPNG": "chart.export({ type:\"png\" }) returns a browser data URL. In Node headless use chart.exportAsync({ type:\"png\" }) after installing the optional canvas package, or fall back to SVG.",
      "exportSVG": "chart.export({ type:\"svg\" }) returns the SVG string in both browser and headless; as:\"dataurl\" for embeds, as:\"blob\" for a Blob (browser).",
      "exportJSON": "chart.export({ type:\"json\" }) returns pretty JSON; use as:\"object\", as:\"dataurl\", or as:\"blob\" for the corresponding representation.",
      "downloadPNG": "chart.downloadPNG() triggers a browser save-as dialog (filename derived from title + timestamp).",
      "downloadSVG": "chart.downloadSVG() same semantics as downloadPNG but for SVG.",
      "downloadJSON": "chart.downloadJSON() saves {version,spec,state} as a .json document.",
      "toDataURL": "chart.toDataURL(\"image/png\"|\"image/svg+xml\") returns a data URL string.",
      "toBlob": "chart.toBlob(\"image/png\"|\"image/svg+xml\") returns a Blob (browser-only)."
    },
    "options": { "as": ["string", "object", "dataurl", "blob"] },
    "branding": "By default PNG/SVG exports include the Powered by iChart.js branding watermark. Pass branding: { enabled: false } or branding: false to remove it for white-label output."
  },
  "gallery": "playground/project-gallery.html",
  "playgroundHome": "playground/index.html",
  "agentWorkbench": "playground/agent-workbench.html",
  "interactionLab": "playground/interaction-lab.html",
  "accessibilityLab": "playground/accessibility-lab.html",
  "performanceLab": "playground/performance-lab.html",
  "businessEditingDemo": "playground/editing.html",
  "diagramEditor": "playground/diagram-editor.html",
  "projectIntelligenceDemo": "playground/project-intelligence.html",
  "foundationalGallery": "playground/foundational-gallery.html",
  "themeGallery": "playground/theme-gallery.html",
  "preferencesLab": "playground/preferences-lab.html",
  "themeGuide": "docs/agent/theme-guide.md",
  "preferences": {
    "version": "1.0",
    "scopes": ["global", "chart"],
    "persistence": ["memory", "localStorage", "adapter"],
    "fields": ["theme.mode", "theme.preset", "theme.palette", "typography.scale", "density", "components.legend", "components.labels", "components.grid", "branding.enabled", "motion"],
    "agentAdjustable": true,
    "interactiveSettingsUI": true,
    "precedence": ["defaults", "global", "chart", "temporary-agent-patch"],
    "discovery": {
      "capabilities": "getPreferenceCapabilities(chartType?, { locale? })",
      "current": "chart.getPreferences()",
      "validate": "validatePreferences(patch, { partial: true })",
      "apply": "chart.setPreferences(patch, { scope, source: 'agent' })",
      "verify": "chart.getState().preferences"
    }
  },
  "styleSystem": {
    "modes": ["auto", "light", "dark", "contrast"],
    "presets": ["auto", "analysis", "dashboard", "report", "presentation", "project", "diagram"],
    "palettes": ["auto", "categorical", "sequential", "diverging", "status"]
  },
  "branding": {
    "defaultEnabled": true,
    "signature": "Powered by iChart.js",
    "options": [
      { "name": "enabled", "type": "boolean", "default": true }
    ],
    "notes": [
      "Default signature rendered in the bottom-right corner inside the chart safe padding, 10px / font-weight 500, theme.muted color with ~0.42 opacity, decorative and non-interactive.",
      "Agents MUST keep branding enabled by default; only disable when the user explicitly requests a white-label / no-brand output or already provides their own signature.",
      "Short form `branding: false` and object form `branding: { enabled: false }` are both supported. Custom text, link, position, or font are intentionally NOT exposed in the current iteration."
    ]
  }
}
