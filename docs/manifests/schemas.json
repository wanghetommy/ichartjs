    "flow-edge": { "key": "id", "required": ["id", "from", "to"], "editable": ["from", "to", "fromPort", "toPort", "label", "status", "routing", "curveTension", "waypoints"] },
    "swimlane": { "key": "id", "required": ["id", "label"], "editable": ["label"] },
